<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- CameraX PreviewView -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- 圓圈覆蓋層 -->
    <com.example.rehabilitationapp.ui.facecheck.CircleOverlayView
        android:id="@+id/overlay_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 🆕 倒數顯示區（一開始隱藏） -->
    <LinearLayout
        android:id="@+id/countdown_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/countdown_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3"
            android:textSize="180sp"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="4"
            android:shadowDy="4"
            android:shadowRadius="8" />

        <TextView
            android:id="@+id/countdown_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="請將臉部對準框框"
            android:textSize="28sp"
            android:textColor="@android:color/white"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />
    </LinearLayout>

    <!-- 状态文本（隱藏） -->
    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- 導引提示（上方） -->
    <TextView
        android:id="@+id/cue_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="32dp"
        android:background="#80000000"
        android:padding="16dp"
        android:text=""
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:gravity="center" />

    <!-- ★ 底部區塊：進度條 + 秒數鼓勵 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="100dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="4dp">
        <!-- 进度条 -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:minHeight="6dp"
            android:maxHeight="6dp"
            android:progressTint="@android:color/holo_blue_bright"
            android:progressBackgroundTint="#40FFFFFF" />

        <!-- 计时器 + 鼓勵文字 -->
        <TextView
            android:id="@+id/timer_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="⏱ 5秒"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:background="#80000000"
            android:padding="4dp" />

    </LinearLayout>

</FrameLayout>