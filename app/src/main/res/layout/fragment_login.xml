<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="false"
    android:paddingTop="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient">

    <!-- 垂直 Guideline (大約 40% 高度，當輸入框區域起點) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_input"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.40" />

    <!-- Logo 圖片 -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_logo"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="100dp"/>

    <!-- App 名稱 -->
    <TextView
        android:id="@+id/appName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="20sp"
        android:textColor="#771534"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- ★★★ 選擇登入方式的按鈕 ★★★ -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnModeFormal"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/login_mode_formal"
        android:textColor="@android:color/black"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/btn_login"
        app:backgroundTint="@null"
        app:layout_constraintTop_toTopOf="@id/guideline_input"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.55"
        android:layout_marginTop="16dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnModeQuick"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/login_mode_quick"
        android:textColor="@android:color/black"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/btn_login"
        app:backgroundTint="@null"
        app:layout_constraintTop_toBottomOf="@id/btnModeFormal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.55"
        android:layout_marginTop="12dp"/>

    <!-- ★★★ A軌：帳密輸入區塊（預設隱藏） ★★★ -->

    <LinearLayout
        android:id="@+id/layoutFormalLogin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/guideline_input"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.55"
        android:layout_marginTop="16dp">

        <!-- ID 輸入框 -->
        <EditText
            android:id="@+id/etId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/login_id"
            android:background="@drawable/login_edittext"
            android:textColor="@android:color/black"
            android:textColorHint="#888888"/>

        <!-- Password 輸入框 -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/login_password"
            android:inputType="textPassword"
            android:background="@drawable/login_edittext"
            android:textColor="@android:color/black"
            android:textColorHint="#888888"
            android:layout_marginTop="16dp"/>

        <!-- 登入按鈕 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="153dp"
            android:layout_height="44dp"
            android:text="@string/login_login"
            android:textColor="@android:color/black"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/btn_login"
            app:backgroundTint="@null"
            android:layout_marginTop="24dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
